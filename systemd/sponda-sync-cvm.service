[Unit]
Description=Sponda CVM quarter ingestion (writes newly filed quarters BRAPI lacks)
After=network-online.target postgresql.service sponda-snapshot-cvm.service
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=2

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sponda/backend
EnvironmentFile=/opt/sponda/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/opt/sponda/venv/bin/python manage.py sync_cvm_filings
Restart=on-failure
RestartSec=900

[Unit]
Description=Sponda CVM fourth-quarter ingestion (derives Q4 from the annual DFP)
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=2

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sponda/backend
EnvironmentFile=/opt/sponda/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/opt/sponda/venv/bin/python manage.py sync_cvm_fourth_quarters
Restart=on-failure
RestartSec=900

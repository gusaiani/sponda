[Unit]
Description=Sponda CVM filing-index snapshot (records what CVM published, and when)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/sponda/backend
EnvironmentFile=/opt/sponda/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/opt/sponda/venv/bin/python manage.py snapshot_cvm_filings
Restart=on-failure
RestartSec=300
StartLimitIntervalSec=1800
StartLimitBurst=2

[Unit]
Description=Write newly filed CVM quarters four times a day

# Four times a day rather than hourly because the work list only changes when
# CVM rebuilds its archive, which appears to be weekly. The run costs one
# query when there is nothing to write, so the cadence is about bounding how
# long a freshly published filing waits rather than about polling pressure.
#
# Offset from the hourly index poll it depends on, so a rebuild detected on
# the hour is ingested within a few hours rather than a day.
#
# Persistent=false, unlike the other timers. Their work is tied to a moment —
# a missed reminder run drops a day of notifications — so they catch up. This
# command re-derives its work list from database state on every run, so a
# missed one costs at most a single interval and nothing is lost. Catch-up
# would also make the very first activation fire immediately, since systemd
# has no previous run recorded, which is the least appropriate moment for the
# first unattended write to production.
[Timer]
OnCalendar=*-*-* 02,08,14,20:20:00
Persistent=false
RandomizedDelaySec=600

[Install]
WantedBy=timers.target

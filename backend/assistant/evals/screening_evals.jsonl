// Screening eval dataset. One JSON case per line; lines starting with // are comments.
// Canonical filter mapping (the scoring canon):
//   "under / below / less than / at most / no more than / up to X"  -> {"max": X}
//   "over / above / more than / at least X"                         -> {"min": X}
//   "between A and B"                                               -> {"min": A, "max": B}
// The screener exposes only inclusive bounds, so strict and inclusive phrasings share one canon.
// Where a mapping is honestly underdetermined (e.g. "single-digit", bare "cheap"),
// expected.filters_any_of lists every defensible parse.
// Expected result sets are hand-derived from evals/universe.py (EVAL_UNIVERSE) — see PR 3.
//
// --- plain-en ---
{"id": "plain-en-01", "language": "en", "category": "plain", "smoke": true, "query": "Companies with PE10 under 8", "expected": {"kind": "screen", "filters": {"pe10": {"max": 8}}, "expected_symbols_subset": ["EVBRA1", "EVBRA2", "EVUSA1", "EVUSA5", "EVDEU1", "EVDEU3"], "min_rows": 6}}
{"id": "plain-en-02", "language": "en", "category": "plain", "query": "Show me companies with a PE10 below 5", "expected": {"kind": "screen", "filters": {"pe10": {"max": 5}}, "expected_symbols_subset": ["EVBRA1", "EVUSA5"], "min_rows": 2}}
{"id": "plain-en-03", "language": "en", "category": "plain", "query": "Companies with current ratio above 2", "expected": {"kind": "screen", "filters": {"current_ratio": {"min": 2}}, "expected_symbols_subset": ["EVBRA2", "EVBRA5", "EVUSA1", "EVUSA2", "EVUSA5"], "min_rows": 5}}
{"id": "plain-en-04", "language": "en", "category": "plain", "query": "Which companies have debt to equity under 0.5?", "expected": {"kind": "screen", "filters": {"debt_to_equity": {"max": 0.5}}, "expected_symbols_subset": ["EVBRA2", "EVBRA5", "EVUSA1", "EVUSA2", "EVUSA5"], "min_rows": 5}}
{"id": "plain-en-05", "language": "en", "category": "plain", "query": "Companies trading below 8 times ten-year free cash flow", "expected": {"kind": "screen", "filters": {"pfcf10": {"max": 8}}, "expected_symbols_subset": ["EVBRA1", "EVBRA2", "EVUSA1", "EVUSA5", "EVDEU1", "EVDEU2"], "min_rows": 6}}
{"id": "plain-en-06", "language": "en", "category": "plain", "query": "Companies with a PEG ratio under 1", "expected": {"kind": "screen", "filters": {"peg": {"max": 1}}, "expected_symbols_subset": ["EVBRA1", "EVBRA2", "EVUSA1", "EVUSA5", "EVDEU1", "EVDEU3"], "min_rows": 6}}
{"id": "plain-en-07", "language": "en", "category": "plain", "query": "Brazilian companies with PE10 under 8", "expected": {"kind": "screen", "filters": {"pe10": {"max": 8}}, "countries": ["BR"], "expected_symbols_subset": ["EVBRA1", "EVBRA2"], "min_rows": 2}}
{"id": "plain-en-08", "language": "en", "category": "plain", "query": "US companies with PE10 below 10", "expected": {"kind": "screen", "filters": {"pe10": {"max": 10}}, "countries": ["US"], "expected_symbols_subset": ["EVUSA1", "EVUSA3", "EVUSA5"], "min_rows": 3}}
{"id": "plain-en-09", "language": "en", "category": "plain", "query": "Companies that could pay off their debt with less than 3 years of free cash flow", "expected": {"kind": "screen", "filters": {"debt_to_avg_fcf": {"max": 3}}, "expected_symbols_subset": ["EVBRA1", "EVBRA2", "EVBRA3", "EVUSA1", "EVUSA2", "EVUSA5", "EVDEU1", "EVDEU2"], "min_rows": 8}}
{"id": "plain-en-10", "language": "en", "category": "plain", "query": "Brazilian companies with PE10 under 8 and debt payable from free cash flow in under 3 years", "expected": {"kind": "screen", "filters": {"pe10": {"max": 8}, "debt_to_avg_fcf": {"max": 3}}, "countries": ["BR"], "expected_symbols_subset": ["EVBRA1", "EVBRA2"], "min_rows": 2}}
